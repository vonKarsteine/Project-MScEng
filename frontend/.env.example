# Base URL of the KOA Multimodal API (stdlib ThreadingHTTPServer).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Initial inference adapter: api | mock | onnx.
# This only seeds the dropdown -- the mode is switchable at runtime.
VITE_INFERENCE_MODE=api

# URL of an exported ONNX graph for the onnxruntime-web adapter.
# Leave empty: the adapter reports that it is not enabled rather than faking a result.
VITE_ONNX_MODEL_URL=
